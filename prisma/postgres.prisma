generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model Conversation {
  id String @id @default(cuid())
  token String @unique @default(cuid())
  channel String @default("Сайт")
  mode String @default("bot")
  revision Int @default(0)
  topic String @default("Общее")
  telegramId String? @unique
  createdAt DateTime @default(now())
  messages Message[]
  lead Lead?
}
model Message {
  id String @id @default(cuid())
  conversationId String
  conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade)
  role String
  text String
  sourceId String?
  sourceTitle String?
  responseMs Int?
  createdAt DateTime @default(now())
  @@index([conversationId,createdAt])
}
model Lead {
  id String @id @default(cuid())
  conversationId String @unique
  conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade)
  name String
  contact String
  company String @default("")
  status String @default("new")
  priority String @default("warm")
  tags String @default("")
  notes String @default("")
  consentAt DateTime
  createdAt DateTime @default(now())
  deliveries Delivery[]
}
model Document {
  id String @id @default(cuid())
  title String
  body String
  keywords String
  updatedAt DateTime @updatedAt
}
model Settings {
  id String @id @default("bot")
  name String @default("Алекс • Нова Системы")
  greeting String @default("Здравствуйте! Я Алекс, помощник Нова Системы. Помогу выбрать автоматизацию, расскажу о стоимости и подключении.")
}
model Delivery {
  @@unique([leadId, adapter])
  id String @id @default(cuid())
  leadId String
  lead Lead @relation(fields:[leadId],references:[id],onDelete:Cascade)
  adapter String
  status String
  createdAt DateTime @default(now())
}
model Initialization {
  id String @id
  createdAt DateTime @default(now())
}
model TelegramUpdate {
  id Int @id
  createdAt DateTime @default(now())
}
